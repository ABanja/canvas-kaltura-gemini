{
  "manifest_version": 3,
  "name": "Kaltura Gemini Assistant for Canvas",
  "short_name": "Kaltura Gemini",
  "version": "0.1.0",
  "description": "Chat with, summarize and quiz yourself on Kaltura videos in Canvas using your own Google Gemini API key.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Kaltura Gemini Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": [
    "https://*.kaltura.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.kaltura.com/*"],
      "js": ["content/kaltura-bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.kaltura.com/*"],
      "js": ["content/kaltura-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
